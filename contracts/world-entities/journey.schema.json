{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awg.local/contracts/world-entities/journey.schema.json",
  "title": "Journey",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "journey_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "state": {
      "enum": [
        "planned",
        "scheduled",
        "departed",
        "in_progress",
        "interrupted",
        "rerouting",
        "arrived",
        "failed",
        "cancelled"
      ]
    },
    "origin": {
      "$ref": "https://awg.local/contracts/common/common.schema.json#/$defs/locationRef"
    },
    "destination": {
      "$ref": "https://awg.local/contracts/common/common.schema.json#/$defs/locationRef"
    },
    "legs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "departed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "arrived_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "current_location": {
      "$ref": "https://awg.local/contracts/common/common.schema.json#/$defs/locationRef"
    },
    "route_revision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "journey_id",
    "actor_id",
    "state",
    "origin",
    "destination",
    "legs",
    "route_revision"
  ],
  "additionalProperties": false
}
