{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awg.local/contracts/commands/send-message.command.schema.json",
  "title": "Send Message Command",
  "allOf": [
    {
      "$ref": "https://awg.local/contracts/commands/base-command.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "command_type": {
          "const": "SendMessage"
        },
        "actor_id": {
          "$ref": "https://awg.local/contracts/common/common.schema.json#/$defs/identifier"
        },
        "channel_id": {
          "$ref": "https://awg.local/contracts/common/common.schema.json#/$defs/identifier"
        },
        "recipient_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://awg.local/contracts/common/common.schema.json#/$defs/identifier"
          }
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "claim_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://awg.local/contracts/common/common.schema.json#/$defs/identifier"
          }
        },
        "visibility": {
          "enum": [
            "private",
            "group",
            "organization",
            "public"
          ]
        }
      },
      "required": [
        "command_type",
        "actor_id",
        "channel_id",
        "recipient_ids",
        "content",
        "visibility"
      ]
    }
  ],
  "unevaluatedProperties": false
}
