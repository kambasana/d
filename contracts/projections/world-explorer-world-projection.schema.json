{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awg.local/contracts/projections/world-explorer-world-projection.schema.json",
  "title": "World Explorer World Projection",
  "type": "object",
  "required": [
    "schema_version",
    "simulation_time",
    "zoom",
    "world_id",
    "state_checksum",
    "agents",
    "clusters",
    "cluster_position_authority",
    "pmtiles_authority",
    "read_only"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "simulation_time": {
      "type": "string",
      "format": "date-time"
    },
    "zoom": {
      "type": "integer",
      "minimum": 1,
      "maximum": 22
    },
    "world_id": {
      "type": "string"
    },
    "state_checksum": {
      "type": "string",
      "minLength": 16
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "agent_id",
          "place_id",
          "position_authority"
        ],
        "additionalProperties": true
      }
    },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cluster_id",
          "cluster_type",
          "position_authority"
        ],
        "additionalProperties": true
      }
    },
    "building_occupancy": {
      "type": [
        "object",
        "null"
      ]
    },
    "cluster_position_authority": {
      "const": "projection_only"
    },
    "pmtiles_authority": {
      "const": "presentation_only"
    },
    "read_only": {
      "const": true
    }
  }
}
