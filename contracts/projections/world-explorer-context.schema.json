{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awg.local/contracts/projections/world-explorer-context.schema.json",
  "title": "World Explorer Context",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "read_only",
    "mutation_allowed",
    "invariants_preserved",
    "external_network_dependencies",
    "worlds",
    "pmtiles_authority"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "bundle_id": {
      "type": "string"
    },
    "read_only": {
      "const": true
    },
    "mutation_allowed": {
      "const": false
    },
    "invariants_preserved": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "external_network_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "worlds": {
      "type": "object",
      "required": [
        "spatial",
        "information",
        "scale"
      ],
      "additionalProperties": false,
      "properties": {
        "spatial": {
          "type": "object"
        },
        "information": {
          "type": "object"
        },
        "scale": {
          "type": "object"
        }
      }
    },
    "static_assets_root": {
      "type": "string"
    },
    "pmtiles_authority": {
      "const": "presentation_only"
    }
  }
}
